# ---- App ----
NODE_ENV=development
PORT=3000
# Public URL Meta will call for webhooks and the encrypted Flow data endpoint.
# Dynamic Flows require public HTTPS (use a tunnel like ngrok in development).
APP_URL=http://localhost:3000

# ---- Auth (Auth.js v5) ----
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string
AUTH_TRUST_HOST=true

# ---- Database ----
DATABASE_URL=postgresql://wa:wa@localhost:5434/wa_admin?schema=public

# ---- Encryption for the WhatsApp access token at rest (AES-256-GCM) ----
# Must be 32 bytes hex (64 hex chars). Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-chars

# ---- Media storage ----
MEDIA_DIR=./storage/media

# ---- WhatsApp Cloud API defaults (per-WABA values are set in the app UI/Settings) ----
GRAPH_API_VERSION=v21.0
